{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SPLIT",
  "version": "2.0.0-1",
  "identifier": "com.necrozzzzzz.split",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SPLIT",
        "width": 980,
        "height": 680,
        "minWidth": 820,
        "minHeight": 560,

        "resizable": true,
        "maximizable": false,
        "fullscreen": false,

        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/SPLIT/screenshots/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
