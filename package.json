{
  "name": "split-v2",
  "private": true,
  "version": "2.0.0-1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:borderless": "node scripts/run-edition.mjs borderless npm run build",
    "build:panorama": "node scripts/run-edition.mjs panorama npm run build",
    "tauri:build:borderless": "node scripts/build-tauri-edition.mjs borderless app",
    "tauri:build:panorama": "node scripts/build-tauri-edition.mjs panorama app",
    "tauri:bundle:borderless": "node scripts/build-tauri-edition.mjs borderless bundle",
    "tauri:bundle:panorama": "node scripts/build-tauri-edition.mjs panorama bundle",
    "build:editions": "npm run tauri:build:borderless && npm run tauri:build:panorama",
    "bundle:editions": "npm run tauri:bundle:borderless && npm run tauri:bundle:panorama",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
